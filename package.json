{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop host for DeepSeek Harness",
  "author": "DeepSeek AI",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run start",
    "start": "pnpm run build && node scripts/launch-electron.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dist:win": "pnpm run build && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac dmg --publish never",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "stage:runtime": "node scripts/stage-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "rcedit": "5.0.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
